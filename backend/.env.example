# -----------------------------------------------------------------------------
# Market Intelligence — Backend Pipeline configuration
# Copy this file to `.env` and adjust paths to your local setup.
# All paths can be absolute or relative to the `backend/` folder.
# -----------------------------------------------------------------------------

# Folder watched for Volza .xlsx files. Drop new files here and the watcher
# will rebuild the dashboard data automatically.
RAW_DATA_DIR=./data/raw

# Canonical aggregated JSON (kept as the source of truth).
PROCESSED_DIR=./data/processed

# Location Vite serves to the React app at /data/final_data.json.
FRONTEND_DATA_PATH=../frontend/public/data/final_data.json

# Small committed fixture so the UI renders without a live pipeline run.
SAMPLE_DATA_PATH=../frontend/public/data/final_data.sample.json

# Log folder (rotating file handler writes pipeline.log here).
LOG_DIR=./logs

# Tuning knobs
CHUNK_SIZE=5000
TABLE_ROWS=100
SAMPLE_ROWS=10
WATCH_DEBOUNCE_SEC=2
